<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- أذونات فلاش الكاميرا الخلفي والاهتزاز والاستماع للإشعارات وظهور وميض الألوان فوق الشاشة -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_flash_tile"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_flash_tile"
        android:supportsRtl="true"
        android:theme="@style/Theme.PixelColorNotify"
        tools:targetApi="35">

        <!-- واجهة التحكم الرئيسية -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PixelColorNotify">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- خدمة الاستماع لإشعارات النظام وتشغيل وميض الفلاش والألوان -->
        <service
            android:name=".PixelColorNotificationService"
            android:label="@string/service_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- خدمة وميض الشاشة بالألوان المخصصة -->
        <service
            android:name=".ScreenColorFlashService"
            android:exported="false" />

        <!-- زر الإعدادات السريعة المدمج في شريط إشعارات أندرويد -->
        <service
            android:name=".PixelQuickSettingsTileService"
            android:icon="@drawable/ic_flash_tile"
            android:label="@string/tile_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
