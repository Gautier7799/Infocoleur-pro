<?xml version="1.0" encoding="utf-8"?>
<!--
    ملف منح امتيازات النظام لتطبيق إشعارات Pixel 8 / Pixel 11 Pro المدمج
    المسار في الهاتف عند الدمج في النظام: /system/etc/permissions/privapp_permissions_pixel_color_notify.xml
-->
<permissions>
    <privapp-permissions package="com.pixel.colornotify">
        <permission name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
        <permission name="android.permission.CAMERA"/>
        <permission name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"/>
        <permission name="android.permission.RECEIVE_BOOT_COMPLETED"/>
        <permission name="android.permission.VIBRATE"/>
        <permission name="android.permission.SYSTEM_ALERT_WINDOW"/>
    </privapp-permissions>
</permissions>
